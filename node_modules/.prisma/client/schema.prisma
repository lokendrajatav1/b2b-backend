generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENDOR
  BUYER
}

enum LeadType {
  IDLE
  DIRECT
  INQUIRY
}

enum LeadStatus {
  PENDING
  DISTRIBUTED
  CLOSED
  EXPIRED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  phone            String?   @unique
  password         String?
  googleId         String?   @unique
  avatar           String?
  role             Role      @default(BUYER)
  isActive         Boolean   @default(true)
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  otp              String?
  otpExpiry        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vendor  Vendor?
  reviews Review[]
}

model Vendor {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  businessName         String
  email                String
  phone                String
  gstNumber            String?
  aadhaarNumber        String?
  city                 String
  categoryId           String
  category             Category @relation(fields: [categoryId], references: [id])
  verified             Boolean  @default(false)
  verificationDocument String?

  // Ranking Factors
  profileCompleteness Int   @default(0)
  responseTime        Float @default(0)
  loginFrequency      Int   @default(0)
  leadClosureRate     Float @default(0)
  totalScore          Float @default(0)
  manualBoost         Float @default(0)

  // Subscription Details
  packageId  String?
  package    Package?  @relation("VendorPackage", fields: [packageId], references: [id])
  planExpiry DateTime?

  description        String?
  address            String?
  socialLinks        Json?
  googleBusinessLink String?
  workingHours       String?

  products       Product[]
  keywords       Keyword[]
  gallery        GalleryImage[]
  certifications Certification[]
  leads          Lead[]
  transactions   Transaction[]
  rankings       Ranking[]
  reviews        Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  url       String
  publicId  String
  createdAt DateTime @default(now())
}

model Certification {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  name      String
  url       String
  createdAt DateTime @default(now())
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  vendors Vendor[]
  leads   Lead[]
}

model Keyword {
  id      String   @id @default(uuid())
  name    String   @unique
  vendors Vendor[]
}

enum OfferingType {
  PRODUCT
  SERVICE
}

model Product {
  id             String       @id @default(uuid())
  vendorId       String
  vendor         Vendor       @relation(fields: [vendorId], references: [id])
  name           String
  description    String?
  price          Float?
  image          String?
  category       String?
  type           OfferingType @default(PRODUCT)
  moq            Int?         @default(1)
  availability   Boolean      @default(true)
  specifications String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Lead {
  id            String   @id @default(uuid())
  buyerName     String
  phone         String
  city          String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  type          LeadType @default(INQUIRY)
  searchKeyword String?
  message       String?  @db.Text

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  status    LeadStatus      @default(PENDING)
  lifecycle LeadLifecycle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeadLifecycle {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model Package {
  id           String        @id @default(uuid())
  name         String
  price        Float
  description  String?
  vendors      Vendor[]      @relation("VendorPackage")
  transactions Transaction[]
}

model Transaction {
  id                String            @id @default(uuid())
  vendorId          String
  vendor            Vendor            @relation(fields: [vendorId], references: [id])
  packageId         String?
  package           Package?          @relation(fields: [packageId], references: [id])
  amount            Float
  currency          String            @default("INR")
  status            TransactionStatus @default(PENDING)
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?           @unique
  razorpaySignature String?

  // Subscription Metadata
  type             String    @default("PURCHASE") // PURCHASE or RENEWAL
  subscriptionDays Int       @default(30)
  expiryAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ranking {
  id       String   @id @default(uuid())
  vendorId String
  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  score    Float
  date     DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemSettings {
  id                       String   @id @default("global")
  rankingWeightProfile     Float    @default(0.4)
  rankingWeightPerformance Float    @default(0.6)
  updatedAt                DateTime @updatedAt
}
